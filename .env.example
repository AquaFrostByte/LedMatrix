# Copy to .env and edit. Never commit .env.

# Prebuilt image from GitHub (leave unset to build locally with --build)
# LEDMATRIX_IMAGE=ghcr.io/YOUR_GITHUB_USER/ledmatrix-server:latest

# MQTT login - must match the user you create in mosquitto/passwd
MQTT_USER=ledmatrix
MQTT_PASS=change-me

# Optional login for the web UI (leave empty for none)
UI_USER=
UI_PASS=

# Only change these if you use an external broker / different topic
# MQTT_HOST=mosquitto
# BASE_TOPIC=ledmatrix
